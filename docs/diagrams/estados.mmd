stateDiagram-v2

    [*] --> Criada

    Criada --> EmAnalise : submeterProposta [dadosValidos] / notificarVendedor()
    Criada --> Cancelada : submeterProposta [dadosInvalidos] / registrarMotivo()

    EmAnalise --> PropostaAceita : aceitarProposta [propostaValida] / registrarAceite()
    EmAnalise --> Cancelada : rejeitarProposta [propostaPendente] / notificarComprador()

    PropostaAceita --> SobraSeparada : separarSobra [quantidadeDisponivel] / reduzirQuantidade()

    SobraSeparada --> AguardandoPagamento : criarCobranca [sobraSeparada] / solicitarEscrow()

    state AguardandoPagamento {
        [*] --> CobrancaCriada
        CobrancaCriada --> Monitorando : iniciarMonitoramento
        Monitorando --> Conciliando : depositoRecebido / iniciarConciliacao()
        Conciliando --> [*] : conciliacaoFinalizada

        Monitorando : entry / iniciarCronometro()
        Monitorando : do / monitorarPagamento()
        Monitorando : exit / encerrarCronometro()
    }

    AguardandoPagamento --> FundosRetidos : confirmarPagamento [pagamentoValido] / registrarCustodia()

    AguardandoPagamento --> Expirada : expirarPagamento [prazoEncerrado] / liberarQuantidade()

    AguardandoPagamento --> Cancelada : recusarPagamento [pagamentoRecusado] / liberarQuantidade()

    FundosRetidos --> Confirmada : confirmarNegociacao [fundosRetidos] / autorizarContinuidade()

    Confirmada --> Concluida : concluirNegocio [negociacaoConfirmada] / registrarConclusao()

    Concluida --> [*]
    Cancelada --> [*]
    Expirada --> [*]
